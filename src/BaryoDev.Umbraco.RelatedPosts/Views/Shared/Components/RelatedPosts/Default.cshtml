@using BaryoDev.Umbraco.RelatedPosts
@model RelatedPostsViewModel
@if (Model.Items.Count > 0)
{
    <section class="bdrp" aria-label="@Model.Heading">
        @if (!string.IsNullOrEmpty(Model.Stylesheet))
        {
            <link rel="stylesheet" href="@Model.Stylesheet" />
        }
        <h2 class="bdrp__heading">@Model.Heading</h2>
        <div class="bdrp__grid">
            @foreach (var item in Model.Items)
            {
                @await Html.PartialAsync("~/Views/Shared/Components/RelatedPosts/_RelatedPostCard.cshtml", item)
            }
        </div>
    </section>
}
