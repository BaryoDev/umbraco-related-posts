@using BaryoDev.Umbraco.RelatedPosts
@model RelatedPostsViewModel
@if (Model.Items.Count > 0)
{
    <section class="bdrp" aria-label="@Model.Heading">
        <link rel="stylesheet" href="/App_Plugins/BaryoDev.RelatedPosts/related-posts.css" />
        <h2 class="bdrp__heading">@Model.Heading</h2>
        <div class="bdrp__grid">
            @foreach (var item in Model.Items)
            {
                <partial name="~/Views/Shared/Components/RelatedPosts/_RelatedPostCard.cshtml" model="item" />
            }
        </div>
    </section>
}
